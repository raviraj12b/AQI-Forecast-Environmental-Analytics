# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs (keep the folder, ignore generated log files)
outputs/logs/*
!outputs/logs/.gitkeep
*.log

# Distribution / build
build/
dist/
*.egg-info/

# Model artifacts — uncomment if trained models should NOT be versioned
# models/trained/*.joblib
# models/trained/*.pkl

# Raw/processed data — uncomment if datasets should NOT be committed
# data/raw/*
# data/processed/*
